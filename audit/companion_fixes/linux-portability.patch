+            raise OSError(e, os.strerror(e))
+        return r.phys_footprint, r.lifetime_max_phys_footprint, r.resident_size
+
+elif sys.platform.startswith("linux"):
+    # Linux port (2026-11-03 audit). NOT the macOS metric: Linux has no phys_footprint. The proxy is
+    # VmRSS + VmSwap from /proc/<pid>/status (resident plus swapped-out anonymous pages); its lifetime
+    # maximum is VmHWM + current VmSwap (Linux keeps no swap high-water mark), so it can under-read the
+    # true peak. Budgets, thresholds and classifications were calibrated on macOS footprint and are not
+    # re-calibrated here; every record carries METRIC so the two are never pooled silently.
+    METRIC = "linux_vmrss_plus_vmswap"
+
+    def usage(pid=None):
+        """Linux: (VmRSS+VmSwap, VmHWM+VmSwap, VmRSS) in bytes; Gone if the process no longer exists."""
+        try:
+            with open(f"/proc/{os.getpid() if pid is None else pid}/status", encoding="ascii") as fh:
+                kv = dict(line.split(":", 1) for line in fh if ":" in line)
+        except FileNotFoundError:
             raise Gone(pid)
-        raise OSError(e, os.strerror(e))
-    return r.phys_footprint, r.lifetime_max_phys_footprint, r.resident_size
+        except ProcessLookupError:
+            raise Gone(pid)
+
+        def kib(name):
+            v = kv.get(name)
+            return int(v.split()[0]) * 1024 if v else 0
+        rss, swap, hwm = kib("VmRSS"), kib("VmSwap"), kib("VmHWM")
+        if "VmRSS" not in kv:  # zombie: no memory lines left
+            raise Gone(pid)
+        return rss + swap, max(hwm, rss) + swap, rss
+
