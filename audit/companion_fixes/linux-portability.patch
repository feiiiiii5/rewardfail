+if sys.platform == "darwin":
+    METRIC = "phys_footprint"
+    _lib = ctypes.CDLL(ctypes.util.find_library("proc") or "/usr/lib/libproc.dylib", use_errno=True)
+    _lib.proc_pid_rusage.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
+    _lib.proc_pid_rusage.restype = ctypes.c_int
+
+    def usage(pid=None):
+        """返回 (footprint, 生命周期内最大 footprint, 常驻内存)，单位字节。进程不在了抛 Gone，其他失败抛 OSError。"""
+        r = _RU4()
