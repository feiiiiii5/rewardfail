digraph design {
  graph [rankdir=LR, nodesep=0.25, ranksep=0.45, fontname="PingFang SC", bgcolor="white", pad=0.20];
  node [shape=box, style="rounded,filled", fillcolor="#EAF1FB", color="#2F5597", fontname="PingFang SC", fontsize=12, margin="0.12,0.07"];
  edge [fontname="PingFang SC", fontsize=10, color="#555555"];
  planned [label="12 次计划执行\n固定回答 + 受控子进程退出"];
  fixed [label="修复版 C0–C6\n7 次（路径 B）"];
  orig [label="原版 O4–O6\n3 次（对照）"];
  restart [label="独立重启 C1r/C2r\n2 次"];
  export [label="导出读回\n_write_generations"];
  verify [label="只读核对\n249 项检查 / 0 失败", fillcolor="#E2F0D9", color="#548235"];
  aborted [label="首次尝试 O5/C5\n7 行 + 2 个 agent worker\n生成阶段 AssertionError", fillcolor="#FBE5D6", color="#C00000"];
  adapted [label="适配：agent worker=1\n奖励 worker 仍为 2\n重跑通过", fillcolor="#FBE5D6", color="#ED7D31"];
  planned -> fixed -> export -> verify;
  planned -> orig -> verify;
  planned -> restart -> verify;
  planned -> aborted [style=dashed, color="#C00000"];
  aborted -> adapted [style=dashed, color="#C00000"];
  adapted -> verify [style=dashed, color="#ED7D31"];
}